# Lynx Server Environment Variables
# Copy this file to .env and modify as needed.
# These override values from config.toml

# LYNX_HOST=127.0.0.1
# LYNX_PORT=6006
# LYNX_MAXCONNECTIONS=1000
# LYNX_LOGLEVEL=info

# Resource management
# LYNX_SLOW_CLIENT_THRESHOLD=50
# LYNX_RATE_LIMIT_PER_SECOND=10.0
# LYNX_RATE_LIMIT_BURST=20

# Alternative: use RUST_LOG for more control over log filtering
# RUST_LOG=info
# RUST_LOG=debug
# RUST_LOG=lynx_server=debug,info
